# Deployer (Hardhat) — generate with: yarn generate
# Local dev: use Hardhat account #0 (already in packages/nextjs/.env.local for verifier)
DEPLOYER_PRIVATE_KEY=

# Verifier wallet — must be FairStakePool owner; issues setCredential after World verify
VERIFIER_PRIVATE_KEY=

# Local demo without World app (see docs/DEMO.md)
DEV_SKIP_WORLD_VERIFY=true
NEXT_PUBLIC_DEV_MODE=true

# Arc Testnet
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# World ID / Selfie Check (https://developer.world.org) — see docs/WORLD_SETUP.md
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ACTION_ID=
WORLD_APP_ID=
WORLD_ACTION_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ENVIRONMENT=staging
DEV_SKIP_WORLD_VERIFY=true
NEXT_PUBLIC_DEV_MODE=true

# ENS (Sepolia) — optional for credential minting
ENS_PRIVATE_KEY=
NEXT_PUBLIC_ENS_PARENT_NAME=fairstake.eth

# Frontend RPC overrides
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
