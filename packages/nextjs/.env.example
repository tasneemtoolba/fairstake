# Copy to .env.local for local dev, or import into Vercel (Settings → Environment Variables)
# Vercel Root Directory must be: packages/nextjs

# === Required for live demo (Arc Testnet) ===
NEXT_PUBLIC_LIVE_DEPLOY=true
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
DEV_SKIP_WORLD_VERIFY=true
NEXT_PUBLIC_DEV_MODE=true
VERIFIER_PRIVATE_KEY=

# === Optional ===
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_ENS_PARENT_NAME=fairstake.eth

# === Real World Selfie Check (optional — disable dev flags above) ===
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ACTION_ID=
WORLD_APP_ID=
WORLD_ACTION_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ENVIRONMENT=staging
